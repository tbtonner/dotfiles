{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$HOME/.config/komorebi/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "cross_boundary_behaviour": "Workspace",
  "mouse_follows_focus": false,
  "default_workspace_padding": 0,
  "default_container_padding": 0,
  "resize_delta": 100,
  "border": true,
  "border_width": 2,
  "border_offset": -1,
  "border_style": "Square",
  "border_colours": {
    "single": "#E6C384",
    "stack": "#957FB8",
    "monocle": "#98BB6C",
    "floating": "#7E9CD8",
    "unfocused": "#54546D",
    "unfocused_locked": "#C34043"
  },
  "ignore_rules": [],
  "floating_applications": [],
  "toggle_float_placement": "CenterAndResize",
  "floating_window_aspect_ratio": [16, 10],
  "manage_rules": [],
  "monitors": [
    {
      "workspaces": [
        { "name": "1", "layout": "BSP" },
        { "name": "2", "layout": "BSP" },
        { "name": "3", "layout": "BSP" },
        { "name": "4", "layout": "BSP" },
        { "name": "5", "layout": "VerticalStack" },
        { "name": "6", "layout": "VerticalStack" },
        { "name": "7", "layout": "Grid" },
        { "name": "8", "layout": "Grid" }
      ]
    }
  ]
}
