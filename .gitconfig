[user]
	email = tom.tonner@couchbase.com
	name = Tom Tonner
	username = tbtonner
	signingkey = B31A941DA969748F 
[commit]
	gpgsign = true
[core]
	editor = nvim
	# builtin file watcher + untracked cache: keeps git status (and the fish prompt) fast in big repos
	fsmonitor = true
	untrackedCache = true
[pull]
	ff = only
[core]
	pager = delta --dark
[alias]
	gud = push --no-verify
	gerrit = push gerrit HEAD:refs/for/master
	originHead = push origin HEAD:refs/for/master
	trustbro = push -f --no-verify
	calm = status -s
	ql = log --oneline --stat
	st = status
	ck = checkout
	same = commit --amend --no-edit
	amend = !git commit --amend && git status
	stashpopforce = stash show -p | git apply && git stash drop
	clones = clone --recurse-submodules
	count-lines = "! git log --author=\"$1\" --pretty=tformat: --numstat | awk '{ add += $1; subs += $2; loc += $1 - $2 } END { printf \"added lines: %s, removed lines: %s, total lines: %s\\n\", add, subs, loc }' #"
[interactive]
    diffFilter = delta --color-only
[add.interactive]
    useBuiltin = false # required for git 2.37.0

[delta]
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
	side-by-side = true
	# delta ignores bat's config file, so name it here; kanagawa-nvim = upstream extras/tmTheme + the treesitter-only rules (calls, fields, operators, punctuation)
	syntax-theme = kanagawa-nvim
	line-numbers = true
	# default 2 truncates long lines in side-by-side; wrap them fully instead
	wrap-max-lines = unlimited
	# kanagawa springGreen (strings) / peachRed (return) hues, kept dark so syntax colours survive but saturated: lines, then changed words (match .claude/themes/kanagawa.json)
	plus-style = syntax "#2E4423"
	minus-style = syntax "#4A1C1D"
	plus-emph-style = syntax "#3A5A26"
	minus-emph-style = syntax "#762D2F"
	# line-number gutters default to ANSI green/red; pin them to the same kanagawa hues
	line-numbers-plus-style = "#98BB6C"
	line-numbers-minus-style = "#FF5D62"

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
[color]
	ui = auto
[gpg]
	program = gpg
[push]
	autoSetupRemote = true

[url "git@github.com:"]
	insteadOf = https://github.com/
[log]
	date = local

# per-machine overrides (not in repo)
[include]
	path = ~/.gitconfig.local
