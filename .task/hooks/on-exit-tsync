#!/usr/bin/env bash
# Push Taskwarrior changes to the sync repo shortly after any command that
# modified tasks. Runs detached and debounced so rapid edits batch into one sync.
# Portable across Linux and macOS (no setsid; flock used only if installed).

# Taskwarrior passes modified tasks on stdin; nothing changed -> nothing to do.
[ -n "$(cat)" ] || exit 0
# tsync runs `task sync` itself; don't recurse.
[ -n "$TSYNC_RUNNING" ] && exit 0

state=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tsync
mkdir -p "$state"
stamp="$$-$RANDOM"
echo "$stamp" >"$state/pending"

TSYNC_RUNNING=1 nohup bash -c '
    sleep 3
    [ "$(cat "$1/pending" 2>/dev/null)" = "$2" ] || exit 0   # a newer edit will sync
    sync=(fish --no-config -c "source ~/.config/fish/functions/tsync.fish; tsync")
    if command -v flock >/dev/null; then exec flock "$1/lock" "${sync[@]}"; else exec "${sync[@]}"; fi
' _ "$state" "$stamp" >>"$state/log" 2>&1 </dev/null &
exit 0
