{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "hideVimModeIndicator": true
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "core@couchbase-claude": true,
    "couchbase@couchbase-claude": true,
    "couchbase-cloud@couchbase-claude": true
  },
  "extraKnownMarketplaces": {
    "couchbase-claude": {
      "source": {
        "source": "github",
        "repo": "couchbaselabs/couchbase-claude"
      }
    }
  },
  "theme": "custom:kanagawa",
  "editorMode": "vim",
  "tui": "fullscreen"
}
